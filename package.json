{
  "name": "a11y-fixer",
  "version": "0.1.0",
  "description": "Accessibility audit bot for GitHub PRs",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/action.ts -o dist --source-map --license licenses.txt",
    "bundle": "ncc build src/action.ts -o dist --source-map --license licenses.txt",
    "dev": "tsc --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@actions/core": "^1.11.0",
    "@actions/github": "^6.0.0",
    "@octokit/rest": "^22.0.1",
    "axe-core": "^4.12.1",
    "playwright": "^1.61.1",
    "yaml": "^2.7.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^22.0.0",
    "@vercel/ncc": "^0.44.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
